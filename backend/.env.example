# Copy to .env for local development. On Render/Vercel, set these in the dashboard.

# --- Supabase Database ---
# Local / migrate from your PC: Direct connection often works (db.<ref>.supabase.co:5432)
# Render and most cloud hosts are IPv4-only → use Session pooler (NOT Direct):
#   Host looks like: aws-0-<region>.pooler.supabase.com
#   Port: 5432 (Session mode)
#   User: postgres.<project-ref>   (not just "postgres")
# Example:
# DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Avoid Transaction mode (port 6543) with Prisma unless you know you need it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Use a long random string in production (never commit the real value)
JWT_SECRET="change-me-to-a-long-random-secret"

# Local default. Render injects PORT automatically — you usually don't set this there.
PORT=3000

# Comma-separated frontend origins allowed by CORS (include your Vercel URL in production)
FRONTEND_URL="http://localhost:5173,https://your-app.vercel.app"
